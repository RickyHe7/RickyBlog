{
  // Cloudflare Workers 部署配置（纯静态资源模式）
  //
  // 为什么需要这个文件：
  //   本项目走的是 Cloudflare Workers（地址形如 *.workers.dev），不是 Pages。
  //   Workers 托管静态站点时，必须有一份 wrangler 配置告诉它「构建产物在哪个目录」，
  //   否则 `npx wrangler deploy` 会因为找不到入口而失败，或者部署出一个什么都返回不了的空壳。
  //
  // name 必须与 Cloudflare 上的 Worker 名一致，它会出现在地址里：
  //   https://rickysblog.1174716217.workers.dev
  //   这里的 rickysblog 就是 name，1174716217 是你账号的子域。
  //
  // ⚠️ 中国大陆访问问题：*.workers.dev 在大陆被 DNS 污染，直连打不开。
  //   解决办法是绑一个自己的域名 —— 也就是取消注释下面的 routes，见 DEPLOY.md。
  //
  // 换地址要同时改两处：这里的 name，以及 astro.config.mjs 里的 CANONICAL_SITE。
  "name": "rickysblog",
  "compatibility_date": "2026-09-19",
  "assets": {
    // astro build 的输出目录
    "directory": "./dist",
    // 访问不存在的路径时返回 dist/404.html（并带 404 状态码），
    // 这样我们那个「这片叶子被风吹走了」的页面才会生效。
    // 别改成 single-page-application —— 那是给 SPA 用的，会把所有路径都返回首页。
    "not_found_handling": "404-page"
  }

  // ───────────────────────────────────────────────────────────────
  // 自定义域名：blog.infinitest.cloud
  //
  // 当前状态：**已在 Cloudflare 控制台绑定并生效**（访问返回 200），
  //           所以下面这段保持注释 —— 不用它也能正常工作。
  //
  // 为什么保留且不启用：
  //   `custom_domain: true` 会要求该域名的 zone 存在于同一个 Cloudflare 账号，
  //   否则 `wrangler deploy` 会**直接失败**，把部署流水线搞挂。
  //   控制台绑定已经达成目的，没必要为了一致性冒这个风险。
  //
  // 什么时候才启用它：
  //   - 想改成「声明式」管理域名（换域名时改这里 + `CANONICAL_SITE` 两处即可）
  //   - 或者哪天控制台上的绑定丢了，想让部署自动补回来
  //   启用前先确认 `infinitest.cloud` 已在本账号（Add a site 完成、NS 已生效）。
  //
  // 绑完/换完域名，**必须同步改** `astro.config.mjs` 的 `CANONICAL_SITE`，
  // 否则 sitemap / canonical / OG / RSS 还指着旧地址（那个大陆打不开的 workers.dev）。
  // ───────────────────────────────────────────────────────────────
  // "routes": [
  //   { "pattern": "blog.infinitest.cloud", "custom_domain": true }
  // ]
}
