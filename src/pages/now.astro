---
import ListLayout from '../layouts/ListLayout.astro';
import Icon from '../components/Icon.astro';
import PlaceholderNote from '../components/PlaceholderNote.astro';
import { NOW } from '../data/optional';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
const hasContent = NOW.groups.length > 0;
---

<ListLayout
  title="近况"
  description="最近在做什么、在学什么、在想什么。比文章更零碎，更新也更随意。"
  posts={posts}
>
  {
    !hasContent ? (
      <PlaceholderNote
        title="还没有内容"
        message="「近况」页的意义在于真实 —— 编一段出来就完全没有意义了。想写的时候，编辑 src/data/optional.ts 里的 NOW 对象。"
        items={[
          '结构是 { updated: "2026-09", intro: "一句话", groups: [{ title: "在做", items: ["…"] }] }',
          '一般会分「在做 / 在读 / 在看」这样的几组',
          'updated 记得改，读者才知道这个页面是不是过期的',
        ]}
      />
    ) : (
      <div class="space-y-8">
        {NOW.updated && (
          <p class="flex items-center gap-1.5 text-xs text-bark-500 dark:text-night-400">
            <Icon name="clock" size={13} />
            更新于 <span class="tabular-nums">{NOW.updated}</span>
          </p>
        )}
        {NOW.intro && (
          <p class="text-sm leading-relaxed text-bark-700 dark:text-night-400">{NOW.intro}</p>
        )}
        {NOW.groups.map((group) => (
          <section>
            <h2 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-widest text-bark-500 dark:text-night-400">
              <Icon name="sprout" size={15} />
              {group.title}
            </h2>
            <ul class="mt-3 space-y-1.5 text-sm text-bark-700 dark:text-night-400">
              {group.items.map((item) => (
                <li class="flex gap-2">
                  <span aria-hidden="true" class="select-none text-maple-500">
                    ·
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    )
  }
</ListLayout>
