---
import ListLayout from '../../layouts/ListLayout.astro';
import Icon from '../../components/Icon.astro';
import { getAllCategories, getPostsByCategory, getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
const categories = getAllCategories(posts);
---

<ListLayout
  title="分类"
  description={`共 ${categories.length} 个分类。按主题分组，比标签更粗一些。`}
  posts={posts}
>
  {
    categories.length === 0 ? (
      <p class="text-sm text-bark-500 dark:text-night-400">还没有任何分类。</p>
    ) : (
      <ul class="space-y-4">
        {categories.map((category) => {
          const list = getPostsByCategory(posts, category.name);
          return (
            <li>
              <section class="rounded-leaf border border-paper-200 bg-white/70 p-5 dark:border-night-700 dark:bg-night-800/60">
                <div class="flex items-center justify-between gap-4">
                  <h2 class="flex items-center gap-2 text-base font-semibold text-bark-900 dark:text-night-100">
                    <Icon name="folder" size={17} class="text-maple-500" />
                    <a
                      href={`/categories/${encodeURIComponent(category.name)}`}
                      class="transition-colors duration-150 hover:text-maple-700 dark:hover:text-maple-300"
                    >
                      {category.name}
                    </a>
                  </h2>
                  <span class="shrink-0 tabular-nums text-xs text-bark-500 dark:text-night-400">
                    {category.count} 篇
                  </span>
                </div>

                <ol class="mt-3 space-y-1.5">
                  {list.slice(0, 4).map((post) => (
                    <li class="flex items-baseline justify-between gap-3 text-sm">
                      <a
                        href={`/posts/${post.id}`}
                        class="truncate text-bark-700 transition-colors duration-150 hover:text-maple-700 dark:text-night-400 dark:hover:text-maple-300"
                      >
                        {post.data.title}
                      </a>
                      <time
                        datetime={post.data.date.toISOString()}
                        class="shrink-0 tabular-nums text-xs text-bark-500 dark:text-night-400/80"
                      >
                        {post.data.date.getFullYear()}
                      </time>
                    </li>
                  ))}
                </ol>

                {list.length > 4 && (
                  <a
                    href={`/categories/${encodeURIComponent(category.name)}`}
                    class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-maple-700 hover:text-maple-800 dark:text-maple-300"
                  >
                    还有 {list.length - 4} 篇
                    <Icon name="chevron-right" size={12} />
                  </a>
                )}
              </section>
            </li>
          );
        })}
      </ul>
    )
  }
</ListLayout>
