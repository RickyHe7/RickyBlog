---
import ListLayout from '../layouts/ListLayout.astro';
import Icon from '../components/Icon.astro';
import { getPublishedPosts, groupByYear } from '../lib/posts';
import { formatDate, getReadingTime } from '../lib/format';

const posts = await getPublishedPosts();
const years = groupByYear(posts);
const firstYear = years.length > 0 ? years[years.length - 1].year : null;
const lastYear = years.length > 0 ? years[0].year : null;
---

<ListLayout
  title="归档"
  description={
    years.length > 0
      ? `按时间排列，共 ${posts.length} 篇${firstYear && lastYear ? `（${firstYear} – ${lastYear}）` : ''}。`
      : '按时间排列。'
  }
  posts={posts}
>
  {
    years.length === 0 ? (
      <p class="text-sm text-bark-500 dark:text-night-400">还没有任何文章。</p>
    ) : (
      <div class="space-y-10">
        {years.map((group) => (
          <section aria-labelledby={`year-${group.year}`}>
            <h2
              id={`year-${group.year}`}
              class="flex items-baseline gap-3 text-lg font-semibold text-bark-900 dark:text-night-100"
            >
              <span class="tabular-nums">{group.year}</span>
              <span class="h-[3px] w-10 rounded-full bg-gradient-to-r from-ginkgo-400 via-maple-500 to-crimson-500" aria-hidden="true" />
              <span class="tabular-nums text-xs font-normal text-bark-500 dark:text-night-400">
                {group.posts.length} 篇
              </span>
            </h2>

            <ol class="mt-4 space-y-1">
              {group.posts.map((post) => {
                const reading = getReadingTime(post.body);
                return (
                  <li class="group flex items-baseline gap-3 rounded-lg px-2 py-2 transition-colors duration-150 hover:bg-paper-200/70 dark:hover:bg-night-800/70">
                    <time
                      datetime={post.data.date.toISOString()}
                      class="w-20 shrink-0 tabular-nums text-xs text-bark-500 dark:text-night-400"
                    >
                      {formatDate(post.data.date).slice(5)}
                    </time>
                    <a
                      href={`/posts/${post.id}`}
                      class="min-w-0 flex-1 text-sm text-bark-900 transition-colors duration-150 group-hover:text-maple-700 dark:text-night-100 dark:group-hover:text-maple-300"
                    >
                      <span class="line-clamp-2-safe">{post.data.title}</span>
                    </a>
                    <span class="hidden shrink-0 items-center gap-1 tabular-nums text-xs text-bark-500 sm:inline-flex dark:text-night-400/80">
                      <Icon name="clock" size={11} />
                      {reading.minutes} 分
                    </span>
                  </li>
                );
              })}
            </ol>
          </section>
        ))}
      </div>
    )
  }
</ListLayout>
