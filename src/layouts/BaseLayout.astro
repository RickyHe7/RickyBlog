---
import '../styles/global.css';

import Analytics from '../components/Analytics.astro';
import AutumnTree from '../components/AutumnTree.astro';
import BaseHead from '../components/BaseHead.astro';
import FallingLeaves from '../components/FallingLeaves.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ParticleField from '../components/ParticleField.astro';
import type { JsonLd } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  jsonLd?: JsonLd[];
  /** 关掉背景落叶（例如 404 页更有意境的克制感） */
  leaves?: boolean;
  /** 关掉左下角那棵掉叶子的树（只在大屏显示） */
  tree?: boolean;
  /** 关掉 canvas 粒子连线背景（含光标节点：光标与附近粒子连线并推开它们） */
  particles?: boolean;
}

const { leaves = true, tree = true, particles = true, ...head } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="h-full">
  <head>
    <BaseHead {...head} />
  </head>
  <body
    class="flex min-h-full flex-col bg-paper-100 text-bark-900 antialiased selection:bg-maple-200 dark:bg-night-900 dark:text-night-100"
  >
    <!-- 键盘用户的第一个 Tab 落点 -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-maple-600 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
    >
      跳到主要内容
    </a>

    {leaves && <FallingLeaves />}

    <!--
      粒子连线背景。刻意排在 FallingLeaves 之后：天光那层带 0.4 的半透明遮罩，
      粒子压在它前面才不会被冲淡（注释里按对比度算好的透明度才对得上）。
    -->
    {particles && <ParticleField />}

    <!-- 左下角的大树：背景层（z-0，内容之下），只在大屏显示 -->
    {tree && <AutumnTree />}

    <!--
      z-10 让内容盖在背景层之上；背景层都是 pointer-events:none，所以不会挡交互。
    -->
    <div class="relative z-10 flex min-h-screen flex-col">
      <Header />
      <main id="main" class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>

    <Analytics />
  </body>
</html>
