---
import '../styles/global.css';

import Analytics from '../components/Analytics.astro';
import BaseHead from '../components/BaseHead.astro';
import CursorTrail from '../components/CursorTrail.astro';
import FallingLeaves from '../components/FallingLeaves.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import type { JsonLd } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  jsonLd?: JsonLd[];
  /** 关掉背景落叶（例如 404 页更有意境的克制感） */
  leaves?: boolean;
  /** 关掉鼠标跟随折线（只在精确指针设备生效，触摸端本来就自动关闭） */
  trail?: boolean;
}

const { leaves = true, trail = true, ...head } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="h-full">
  <head>
    <BaseHead {...head} />
  </head>
  <body
    class="flex min-h-full flex-col bg-paper-100 text-bark-900 antialiased selection:bg-maple-200 dark:bg-night-900 dark:text-night-100"
  >
    <!-- 键盘用户的第一个 Tab 落点 -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-maple-600 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
    >
      跳到主要内容
    </a>

    {leaves && <FallingLeaves />}

    <!--
      z-10 让内容盖在落叶层之上；落叶层是 pointer-events:none，所以不会挡交互。
    -->
    <div class="relative z-10 flex min-h-screen flex-col">
      <Header />
      <main id="main" class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>

    <!--
      折线层在内容之上、吸顶导航之下（global.css 里 z-30），
      同样 pointer-events:none，所以不影响点击与文字选中。
      放在内容之后是为了让它压在文字上 —— 否则遇到有底色的卡片会整条消失。
    -->
    {trail && <CursorTrail />}

    <Analytics />
  </body>
</html>
