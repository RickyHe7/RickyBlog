---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import type { Post } from '../lib/posts';
import type { JsonLd } from '../lib/seo';

/**
 * 列表类页面的统一骨架：左侧主内容 + 右侧边栏（窄屏自动折叠到内容下方）。
 */
interface Props {
  title: string;
  description?: string;
  /** 传入已发布的全部文章，边栏的分类/标签/系列/最新都由它推导 */
  posts: Post[];
  currentPath?: string;
  jsonLd?: JsonLd[];
  /** 想自己控制主内容宽度时打开 */
  wide?: boolean;
}

const {
  title,
  description,
  posts,
  currentPath = Astro.url.pathname,
  jsonLd = [],
  wide = false,
} = Astro.props;
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_17rem]">
      <div class:list={['min-w-0', wide && 'mx-auto w-full max-w-3xl']}>
        <header class="mb-8">
          <h1
            class="text-2xl font-bold tracking-tight text-bark-900 sm:text-3xl dark:text-night-100"
          >
            {title}
          </h1>
          {description && (
            <p class="mt-2 text-sm leading-relaxed text-bark-500 sm:text-base dark:text-night-400">
              {description}
            </p>
          )}
          <!-- 秋色分隔线 -->
          <div
            class="mt-4 h-[3px] w-16 rounded-full bg-gradient-to-r from-ginkgo-400 via-maple-500 to-crimson-500"
            aria-hidden="true"
          >
          </div>
        </header>

        <slot />
      </div>

      <div class="lg:sticky lg:top-20 lg:max-h-[calc(100vh-6rem)] lg:self-start lg:overflow-y-auto lg:pr-1">
        <Sidebar posts={posts} currentPath={currentPath} />
      </div>
    </div>
  </div>
</BaseLayout>
