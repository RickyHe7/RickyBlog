---
import { SITE } from '../consts';
import { absoluteUrl, type JsonLd } from '../lib/seo';
import { withBase } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** 社交分享图，传站内路径即可 */
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  jsonLd?: JsonLd[];
}

const {
  title,
  description = SITE.description,
  image = '/og-default.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
  jsonLd = [],
} = Astro.props;

const site = Astro.site;
const pageTitle = title ? `${title} | ${SITE.titleSuffix}` : `${SITE.name} · ${SITE.tagline}`;
const canonical = absoluteUrl(Astro.url.pathname, site);
const ogImage = absoluteUrl(image, site);
const ogImageAlt = title ? `${title} — ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- 图标：手写 SVG 枫叶，无第三方素材 -->
<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
<link rel="apple-touch-icon" href={withBase('/favicon.svg')} />
<link rel="sitemap" type="application/xml" href={withBase('/sitemap-index.xml')} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.name} · RSS`}
  href={absoluteUrl('/rss.xml', site)}
/>

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:title" content={title ?? `${SITE.name} · ${SITE.tagline}`} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? `${SITE.name} · ${SITE.tagline}`} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime.toISOString()} />
)}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- 主题色（跟随系统与手动切换） -->
<meta name="theme-color" content="#fbf6ee" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#16110c" media="(prefers-color-scheme: dark)" />

<!--
  防暗色模式闪烁（FOUC）。
  必须是 inline + 阻塞的：任何延迟执行的脚本都会让页面先用亮色画一帧再跳成暗色。
-->
<script is:inline>
  (() => {
    try {
      const stored = localStorage.getItem('theme');
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const isDark = stored ? stored === 'dark' : systemDark;
      document.documentElement.classList.toggle('dark', isDark);
    } catch (_) {
      /* localStorage 被禁用时静默降级为亮色 */
    }
  })();
</script>

{jsonLd.map((data) => (
  <script type="application/ld+json" set:html={JSON.stringify(data)} />
))}
