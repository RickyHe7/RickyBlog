---
/**
 * 内联 SVG 图标集。
 *
 * 刻意不引图标库：全套手写路径，零依赖、零版权问题、无额外网络请求。
 * 线条图标统一 24×24、stroke-width 1.75、圆头圆角；品牌图标用填充。
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
  /** 纯装饰图标应保持 aria-hidden；有语义时传 label */
  label?: string;
}

const { name, size = 20, class: className = '', label } = Astro.props;

const LEAF_D =
