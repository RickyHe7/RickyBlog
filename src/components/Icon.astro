  link: `<path d="M10.5 13.5a5 5 0 0 0 7.1 0l2.1-2.1a5 5 0 0 0-7.1-7.1l-1 1" /><path d="M13.5 10.5a5 5 0 0 0-7.1 0l-2.1 2.1a5 5 0 0 0 7.1 7.1l1-1" />`,
  list: `<path d="M4 6h16M4 12h16M4 18h10" />`,
  book: `<path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H19v18H6.5A1.5 1.5 0 0 1 5 19.5Z" /><path d="M5 8h14" />`,
  monitor: `<rect x="2.5" y="4" width="19" height="12.5" rx="2" /><path d="M8 20h8M12 16.5V20" />`,
