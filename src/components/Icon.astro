  'arrow-left': `<path d="M19 12H5M12 19l-7-7 7-7" />`,
  'arrow-right': `<path d="M5 12h14M12 5l7 7-7 7" />`,
  tag: `<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0l-7.2-7.2A2 2 0 0 1 2.8 12V5a2 2 0 0 1 2-2h7a2 2 0 0 1 1.4.6l7.4 7.4a2 2 0 0 1 0 2.8Z" /><circle cx="7.6" cy="7.6" r="1.2" />`,
  folder: `<path d="M3 7a2 2 0 0 1 2-2h3.6l2 2H19a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" />`,
  calendar: `<rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4M16 3v4M3 11h18" />`,
  clock: `<circle cx="12" cy="12" r="9" /><path d="M12 7v5.2l3.2 2" />`,
