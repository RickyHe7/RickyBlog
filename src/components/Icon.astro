    <path d="M7.2 3.6 9.8 6.8M16.8 3.6 14.2 6.8" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
    <rect x="7.3" y="11" width="3.2" height="3.6" rx="1.1" fill="currentColor" />
    <rect x="13.5" y="11" width="3.2" height="3.6" rx="1.1" fill="currentColor" />`,

  // ---------------------------------------------------------------- 线条（描边）
  sun: `<circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />`,
  moon: `<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />`,
  menu: `<path d="M4 7h16M4 12h16M4 17h16" />`,
  close: `<path d="M6 6l12 12M18 6L6 18" />`,
