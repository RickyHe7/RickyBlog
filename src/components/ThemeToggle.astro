---
/**
 * 明暗主题切换按钮。
 *
 * 实际的初始主题由 BaseHead 里的内联脚本在首帧前决定（防闪烁），
 * 这里只负责点击切换 + 持久化。
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  class={`inline-flex h-9 w-9 items-center justify-center rounded-full border border-paper-300 bg-white/70 text-bark-700 transition-colors duration-150 hover:border-maple-300 hover:text-maple-700 dark:border-night-600 dark:bg-night-800/70 dark:text-night-400 dark:hover:border-maple-800 dark:hover:text-maple-300 ${className}`}
  aria-label="切换深色 / 浅色模式"
  title="切换深色 / 浅色模式"
>
  <!-- 亮色时显示月亮（点了会变暗），暗色时显示太阳 -->
  <svg
    class="h-[18px] w-[18px] dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
  </svg>
  <svg
    class="hidden h-[18px] w-[18px] dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4" />
    <path
      d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"
    />
  </svg>
</button>

<script>
  const KEY = 'theme';

  function setTheme(isDark: boolean) {
    document.documentElement.classList.toggle('dark', isDark);
    try {
      localStorage.setItem(KEY, isDark ? 'dark' : 'light');
    } catch (_) {
      /* 忽略：隐私模式下写不了 localStorage */
    }
    document.dispatchEvent(
      new CustomEvent('themechange', { detail: { theme: isDark ? 'dark' : 'light' } })
    );
  }

  // 用事件委托，页面上有几个切换按钮都能工作
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (!target?.closest('[data-theme-toggle]')) return;
    setTheme(!document.documentElement.classList.contains('dark'));
  });
</script>
