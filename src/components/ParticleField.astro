---
/**
 * Canvas 粒子连线背景 —— 粒子织成一张网，**光标本身也是网上的一个节点**。
 *
 * 机制来自 https://www.cnblogs.com/hanxiaochuang666/p/11089904.html 里那个「粒子连线」脚本：
 * 随机粒子缓慢漂移，距离足够近的两点之间连一条线，线的粗细与透明度按距离衰减；
 * 光标附近（`CURSOR_DIST` 内）的粒子会和光标连线，更近的那圈（`CURSOR_PUSH_DIST` 内）
 * 会被轻轻推开 —— 这才是这层的看点。
 *
 * 采用时做了这些修正（原文的写法直接搬到现代页面上有实际毛病，不是随手改的）：
 *   1. **鼠标节点保留，但逻辑重写了。** 原文把光标塞进粒子数组一起跑 O(n²)，而且「推开」
 *      只在 **100~141px 的那一圈**生效 —— 它判断的是 `l >= n.max / 2`，所以比 100px 更近的
 *      粒子反倒不会被推。那是段 bug 式的逻辑（原作者大概没细看），这里改成
 *      从光标中心向外平滑衰减地推开，并且**按 dt 归一**（原文每帧固定位移，
 *      144Hz 屏上推得比 60Hz 快 2.4 倍）。
 *      另外**推开半径与连线半径分开**（72 / 141）：两者取同一个值会产生一个反直觉的后果 ——
 *      光标停住一两秒就把周围清空，于是「光标连线」自己也消失了。
 *   2. **补 devicePixelRatio。** 原文只用 CSS 像素设 canvas 尺寸，在 2x 屏上整层是模糊的。
 *   3. **给点补 fillStyle。** 原文只在画线前设了 strokeStyle，画点前没设 fillStyle ——
 *      点实际用的是 canvas 默认的黑色。这里每个粒子带自己的颜色。
 *   4. **速度按时间推进（px/秒）**，不是 ±1 px/帧 —— 后者在 144Hz 屏上会比 60Hz 快 2.4 倍。
 *   5. **粒子数按视口面积算**，不是写死 260：写死的话 4K 屏上稀得看不出、手机上糊成一片。
 *   6. **切到后台标签页就停掉 rAF**，不空转。
 *   7. 主题切换时重取颜色 —— 监听 ThemeToggle 已经发出来的 `themechange` 事件，不另造一套。
 *
 * 层级：在天光/落叶之上、大树与正文之下（正文是 z-10），所以不会压到内容。
 * 透明度是按**对比度算过**的（见下面 lineAlphaMax 的注释），不是随手填的。
 */
---

<div class="particle-field" aria-hidden="true" data-pagefind-ignore>
  <canvas class="particle-canvas"></canvas>
</div>

<script>
  /** 一套配色 + 两个透明度上限。改这两个数就是调这层的浓淡。 */
  interface Palette {
    /** 设计令牌名，绘制前解析成实际色值 */
    colors: string[];
    /**
     * 连线的最大透明度。**这个是按对比度定的，别随手调高。**
     *
     * 页面容器是透明的，所以这些线可能正好压在正文链接上。最坏情况是
     * 「天光最浓处 (rgb(249,231,214)) + 最深的 crimson-400 线正好从 maple-700
     * 链接字形上穿过」→ 链接对比度 ≈ 4.5:1，刚过 AA。再往上调就会跌破 AA。
     */
    lineAlphaMax: number;
    /** 粒子点的透明度。点是 1~2px 的小圆，压在字形上的面积可忽略，所以可以更实一点。 */
    dotAlpha: number;
  }

  const LIGHT: Palette = {
    colors: ['--color-ginkgo-500', '--color-maple-500', '--color-crimson-400'],
    lineAlphaMax: 0.13,
    dotAlpha: 0.34,
  };
  const DARK: Palette = {
    colors: ['--color-ginkgo-400', '--color-maple-300', '--color-crimson-400'],
    lineAlphaMax: 0.2,
    dotAlpha: 0.4,
  };

  /** 令牌取不到时的兜底（正常情况下永远用不上） */
  const FALLBACK: Record<string, string> = {
    '--color-ginkgo-500': '#d9a62e',
    '--color-ginkgo-400': '#e8c05a',
    '--color-maple-500': '#e2701f',
    '--color-maple-300': '#f5b07b',
    '--color-crimson-400': '#d9564a',
  };

  const LINK_DIST = 104; // 连线距离（CSS px）。原文是平方距离 6e3 ≈ 77.5px，这里拉长一点让网更成形
  const SPEED_MIN = 7; // px/秒 —— 背景层要慢，原文 ±1px/帧 ≈ 60px/秒太快了
  const SPEED_MAX = 15;
  const DPR_MAX = 2; // 3x 屏按 2 倍算就够，再高只是白烧 GPU

  /**
   * ⭐ 密度是**让这层看得见的主要手段，而且它不花对比度**。
   *
   * 每条线单独看仍然是 lineAlphaMax 那个上限，粒子多只是让线多几条 ——
   * 所以想让效果更明显，应该往这里调，而不是往上调 lineAlphaMax。
   *
   * 这个值是被"看"出来的：按 22000 试过，1600×900 只有 65 个粒子，
   * 240×150 的范围内期望只有 1.6 个点，实际观感接近**一张空白纸**，
   * 根本读不出"连线"。用 Pillow 把粒子场按真实参数渲染成图对比后，定在 6500：
   * 1600×900 → 222 个（每颗粒子约 5 个邻点，网织得起来），390×844 手机 → 51 个。
   */
  const AREA_PER_PARTICLE = 6500; // 每个粒子大约占多少平方像素（越小越密）
  const COUNT_MIN = 40;
  const COUNT_MAX = 260; // 上限：260 时每帧约 3.4 万次配对比较，仍然很轻。
  // 大型桌面窗口（如 1920×1080）会撞到上限，此时要靠下调 LINK_DIST 减负（连线数随它平方变化）
  const LINE_ALPHA_FLOOR = 0.25; // 一条线最远端的透明度占比（对应原文的 `t + .2` 那个下限）

  // —— 光标节点 ——
  /** 光标能连到多远的粒子。原文是平方距离 2e4（= 141px），保持一致 */
  const CURSOR_DIST = 141;
  /**
   * 推开粒子的半径，**故意比 `CURSOR_DIST` 小**。
   *
   * 两个半径相同会踩一个坑（实测过）：光标停住 1.5 秒，141px 内就被清空，
   * 于是**「光标连线」自己也归零了** —— 最想看的那个效果反而消失。
   * 只推内圈、留住 72~141px 那一圈，才是「近处被拨开 + 往外牵出几根线」的样子；
   * 而且这样推开范围会自平衡：内圈推力大、越靠边越小，最终稳定在推力 = 粒子自身漂移
   * 的那个半径上（约 50px），不会一直扩大。
   */
  const CURSOR_PUSH_DIST = 72;
  /** 推开粒子的最大速度（px/秒，越靠近光标越接近这个值）。按 dt 归一，不是每帧固定位移 */
  const CURSOR_PUSH = 40;

  interface Particle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    r: number;
    colorIndex: number;
  }

  const wrapper = document.querySelector<HTMLElement>('.particle-field');
  const canvas = wrapper?.querySelector<HTMLCanvasElement>('.particle-canvas');
  const ctx = canvas?.getContext('2d') ?? null;

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 「减少动效」时整层不做（CSS 里也 display:none 兜了一层，见 global.css）
  if (wrapper && canvas && ctx && !reduceMotion) {
    let width = 0;
    let height = 0;
    let particles: Particle[] = [];
    let active: Palette = LIGHT;
    /** 已解析成 #rrggbb 的色值；粒子只存索引，所以换主题时下一帧就跟着变 */
    let colorValues: string[] = [];
    let frame = 0;
    let lastTime = 0;
    /** 光标位置（CSS px，视口坐标）。NaN = 页面上当前没有指针 */
    let cursorX = Number.NaN;
    let cursorY = Number.NaN;

    const isDark = () => document.documentElement.classList.contains('dark');

    const resolveToken = (token: string) =>
      getComputedStyle(document.documentElement).getPropertyValue(token).trim() ||
      FALLBACK[token] ||
      '#e2701f';

    const refreshPalette = () => {
      active = isDark() ? DARK : LIGHT;
      colorValues = active.colors.map(resolveToken);
    };

    const createParticle = (x: number, y: number): Particle => {
      const angle = Math.random() * Math.PI * 2;
      const speed = SPEED_MIN + Math.random() * (SPEED_MAX - SPEED_MIN);

      return {
        x,
        y,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed,
        // 半径和大小错开一点，否则会像一层均匀的网格
        r: 0.8 + Math.random() * 0.9,
        colorIndex: Math.floor(Math.random() * colorValues.length),
      };
    };

    const resize = () => {
      const nextWidth = window.innerWidth;
      const nextHeight = window.innerHeight;
      // 窗口尺寸变化时按比例挪动已有粒子，而不是重新撒一遍（否则拉窗口会「闪」一下）
      const scaleX = width ? nextWidth / width : 1;
      const scaleY = height ? nextHeight / height : 1;

      width = nextWidth;
      height = nextHeight;

      const dpr = Math.min(window.devicePixelRatio || 1, DPR_MAX);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      // 把绘制单位统一成 CSS px，后面所有坐标都不用再乘 dpr
      // （注意：改 canvas.width 会重置变换矩阵，所以必须在这之后设）
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      for (const p of particles) {
        p.x *= scaleX;
        p.y *= scaleY;
      }

      const target = Math.max(
        COUNT_MIN,
        Math.min(COUNT_MAX, Math.round((width * height) / AREA_PER_PARTICLE))
      );

      particles = particles.slice(0, target);
      while (particles.length < target) {
        particles.push(createParticle(Math.random() * width, Math.random() * height));
      }
    };

    /** 距离占比 t（0~1，越近越大）→ 这条线的透明度。两种线共用，保证上限一致。 */
    const lineAlpha = (t: number) =>
      (LINE_ALPHA_FLOOR + (1 - LINE_ALPHA_FLOOR) * t) * active.lineAlphaMax;

    const draw = (now: number) => {
      // 切回标签页时 now 会跳很大一截，钳一下免得粒子瞬移
      const dt = Math.min(now - lastTime, 50) / 1000;
      lastTime = now;

      ctx.clearRect(0, 0, width, height);

      const maxDist2 = LINK_DIST * LINK_DIST;
      const hasCursor = Number.isFinite(cursorX) && Number.isFinite(cursorY);
      const cursorDist2 = CURSOR_DIST * CURSOR_DIST;
      const pushDist2 = CURSOR_PUSH_DIST * CURSOR_PUSH_DIST;

      // ① 移动 + 绕回；光标在时顺手把附近的粒子往外推一点
      for (const p of particles) {
        p.x += p.vx * dt;
        p.y += p.vy * dt;

        if (hasCursor) {
          const dx = p.x - cursorX;
          const dy = p.y - cursorY;
          const d2 = dx * dx + dy * dy;

          // d2 的下限是防除零；推的力度从光标中心向外平滑衰减到 0
          if (d2 < pushDist2 && d2 > 0.01) {
            const d = Math.sqrt(d2);
            const step = (1 - d / CURSOR_PUSH_DIST) * CURSOR_PUSH * dt;
            p.x += (dx / d) * step;
            p.y += (dy / d) * step;
          }
        }

        // 出界就绕到对面。原文是翻转速度方向，那样粒子会在边缘堆一小会儿；
        // 绕回来分布更均匀，而且边界外留一个 LINK_DIST 的余量，连线不会突然断在边上。
        if (p.x < -LINK_DIST) p.x = width + LINK_DIST;
        else if (p.x > width + LINK_DIST) p.x = -LINK_DIST;
        if (p.y < -LINK_DIST) p.y = height + LINK_DIST;
        else if (p.y > height + LINK_DIST) p.y = -LINK_DIST;
      }

      // ② 粒子之间的连线
      for (let i = 0; i < particles.length; i += 1) {
        const a = particles[i];
        ctx.strokeStyle = colorValues[a.colorIndex] ?? colorValues[0];

        for (let j = i + 1; j < particles.length; j += 1) {
          const b = particles[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const dist2 = dx * dx + dy * dy;

          if (dist2 > maxDist2) continue;

          const t = 1 - dist2 / maxDist2; // 越近越实
          ctx.globalAlpha = lineAlpha(t);
          ctx.lineWidth = 0.4 + 0.5 * t;

          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }

      // ③ 光标 → 粒子的连线。这就是「鼠标移动有反应」的那部分
      if (hasCursor) {
        ctx.strokeStyle = colorValues[1] ?? colorValues[0]; // 固定用主色，读起来像"光标那一条"
        for (const p of particles) {
          const dx = cursorX - p.x;
          const dy = cursorY - p.y;
          const dist2 = dx * dx + dy * dy;

          if (dist2 > cursorDist2) continue;

          const t = 1 - dist2 / cursorDist2;
          ctx.globalAlpha = lineAlpha(t);
          ctx.lineWidth = 0.4 + 0.5 * t;

          ctx.beginPath();
          ctx.moveTo(cursorX, cursorY);
          ctx.lineTo(p.x, p.y);
          ctx.stroke();
        }
      }

      // ④ 点最后画，压在线头上，交叉处更干净
      ctx.globalAlpha = active.dotAlpha;
      for (const p of particles) {
        ctx.fillStyle = colorValues[p.colorIndex] ?? colorValues[0];
        ctx.beginPath();
        // 原文是 fillRect(x-.5, y-.5, 1, 1) 的 1px 方块，在 2x 屏上会糊；小圆点更干净
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;

      frame = window.requestAnimationFrame(draw);
    };

    const start = () => {
      if (frame) return;
      lastTime = performance.now();
      frame = window.requestAnimationFrame(draw);
    };

    const stop = () => {
      if (frame) window.cancelAnimationFrame(frame);
      frame = 0;
    };

    refreshPalette(); // 必须在建粒子之前，createParticle 要用 colorValues.length
    resize();
    start();

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(resize, 180);
    });

    // 换主题只换颜色，不用重启循环：色值按索引在每帧取，下一帧就是新配色
    document.addEventListener('themechange', refreshPalette);

    // —— 光标节点 ——
    // 只在鼠标 / 触控笔上生效：触摸端没有 hover，「跟随」没有意义
    const trackCursor = (event: PointerEvent) => {
      if (event.pointerType !== 'mouse' && event.pointerType !== 'pen') return;
      cursorX = event.clientX;
      cursorY = event.clientY;
    };

    // 指针离开窗口时把光标节点收掉，否则会在边缘留下一坨连线
    const clearCursor = () => {
      cursorX = Number.NaN;
      cursorY = Number.NaN;
    };

    window.addEventListener('pointermove', trackCursor, { passive: true });
    document.addEventListener('pointerout', (event) => {
      // relatedTarget 为 null = 指针离开了文档（而不是在元素之间移动）
      if (!event.relatedTarget) clearCursor();
    });
    window.addEventListener('blur', clearCursor);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        clearCursor(); // 切走时一起收掉，回来不会还留着线条
        stop();
      } else {
        start();
      }
    });
  }
</script>
