---
import type { MarkdownHeading } from 'astro';
import Icon from './Icon.astro';

interface Props {
  headings: MarkdownHeading[];
  /** inline = 移动端折叠块；sticky = 桌面端吸顶侧栏 */
  variant?: 'inline' | 'sticky';
  class?: string;
}

const { headings, variant = 'sticky', class: className = '' } = Astro.props;

// 只取 h2 / h3：更深的层级在小屏会挤成一团，收益也低
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{
  toc.length > 0 && (
    <>
      {variant === 'sticky' ? (
        <nav
          aria-label="文章目录"
          data-toc
          class:list={[
            'rounded-leaf border border-paper-200 bg-white/70 p-4 dark:border-night-700 dark:bg-night-800/60',
            className,
          ]}
        >
          <h2 class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-widest text-bark-500 dark:text-night-400">
            <Icon name="list" size={14} />
            目录
          </h2>
          <ol class="mt-3 max-h-[60vh] space-y-1 overflow-y-auto pr-1 text-sm">
            {toc.map((heading) => (
              <li style={`padding-left:${(heading.depth - 2) * 0.8}rem`}>
                <a
                  href={`#${heading.slug}`}
                  data-toc-link
                  class="block rounded px-1.5 py-1 leading-snug text-bark-500 transition-colors duration-150 hover:bg-paper-100 hover:text-maple-700 dark:text-night-400 dark:hover:bg-night-700 dark:hover:text-maple-300"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      ) : (
        <details
          data-toc
          class:list={[
            'rounded-leaf border border-paper-200 bg-white/70 px-4 py-3 lg:hidden dark:border-night-700 dark:bg-night-800/60',
            className,
          ]}
        >
          <summary class="flex cursor-pointer list-none items-center gap-1.5 text-sm font-medium text-bark-700 marker:content-none dark:text-night-100">
            <Icon name="list" size={15} />
            目录
            <Icon name="chevron-down" size={14} class="ml-auto opacity-60" />
          </summary>
          <nav aria-label="文章目录">
            <ol class="mt-3 space-y-1 text-sm">
              {toc.map((heading) => (
                <li style={`padding-left:${(heading.depth - 2) * 0.8}rem`}>
                  <a
                    href={`#${heading.slug}`}
                    data-toc-link
                    class="block rounded px-1.5 py-1 leading-snug text-bark-500 transition-colors duration-150 hover:bg-paper-100 hover:text-maple-700 dark:text-night-400 dark:hover:bg-night-700 dark:hover:text-maple-300"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </details>
      )}
    </>
  )
}

<script>
  // 滚动时高亮目录里对应的条目。
  // 用 IntersectionObserver 而不是 scroll 事件，避免每帧读取布局导致掉帧。
  const tocs = document.querySelectorAll<HTMLElement>('[data-toc]');
  if (tocs.length > 0) {
    const article =
      document.querySelector<HTMLElement>('[data-article-body]') ?? document.body;
    const headings = Array.from(
      article.querySelectorAll<HTMLElement>('h2[id], h3[id]')
    );
    const linksBySlug = new Map<string, HTMLElement[]>();
    tocs.forEach((toc) => {
      toc.querySelectorAll<HTMLElement>('[data-toc-link]').forEach((link) => {
        const slug = link.getAttribute('href')?.slice(1);
        if (!slug) return;
        const bucket = linksBySlug.get(slug);
        if (bucket) bucket.push(link);
        else linksBySlug.set(slug, [link]);
      });
    });

    const setActive = (slug: string | null) => {
      linksBySlug.forEach((links, key) => {
        links.forEach((link) => {
          const on = key === slug;
          link.classList.toggle('bg-maple-100', on);
          link.classList.toggle('font-medium', on);
          link.classList.toggle('text-maple-800', on);
          link.classList.toggle('dark:bg-night-700', on);
          link.classList.toggle('dark:text-maple-300', on);
        });
      });
    };

    let visibleSlug: string | null = null;
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) {
          visibleSlug = visible[0].target.id;
        } else if (entries.every((entry) => !entry.isIntersecting)) {
          // 全部离开视口时不改动，避免高亮闪烁
          return;
        }
        setActive(visibleSlug);
      },
      { rootMargin: '-88px 0px -70% 0px', threshold: 0 }
    );

    headings.forEach((heading) => observer.observe(heading));
  }
</script>
