#
# Ricky's Blog — 环境变量示例
#
# 用法：复制为 .env 后按需填写。
#   本地：cp .env.example .env
#   Cloudflare：Worker → Settings → Variables and Secrets 里逐条添加
#
# 重要：所有外部服务都是「可选」的。
#       只要保持留空，对应组件就不会渲染，构建依然 100% 通过。
#

# ---------------------------------------------------------------
# 站点地址 —— 这里不需要配置
# ---------------------------------------------------------------
# 站点地址的唯一来源是 astro.config.mjs 里的 CANONICAL_SITE，换域名只改那一行。
#
# ⚠️ 不要再设 SITE_URL：这个变量曾经把线上域名整个盖成旧域名，
#    导致 sitemap / canonical 一直指错地址，代码层面已经彻底禁用它的读取。
#
# 仅当你想「临时用另一个域名构建」时才用下面这个开关（刻意换了不常见的名字）：
# FORCE_SITE_URL=https://临时域名
#
# 也绝不要把地址填成 https://rickyblog.pages.dev —— 那个域名属于别人的博客（实测确认）。


# ---------------------------------------------------------------
# 评论：Giscus（需要公开仓库 + 已开启 Discussions）
# 四个值全部填写后评论区块才会出现，否则静默隐藏。
# 取值地址：https://giscus.app/zh-CN （在页面上输入仓库名即可拿到 ID）
# ---------------------------------------------------------------
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=


# ---------------------------------------------------------------
# 访问统计：Umami（Cloud 或自建都行）
# 两个值都填写后脚本才会注入。
# PUBLIC_UMAMI_SRC 例：https://cloud.umami.is/script.js
# ---------------------------------------------------------------
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_WEBSITE_ID=


# ---------------------------------------------------------------
# 邮件订阅：Buttondown
# 只填用户名（buttondown.com/<username>）即可，留空则隐藏订阅表单。
# ---------------------------------------------------------------
PUBLIC_BUTTONDOWN_USERNAME=
